<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Make the five former special Archotech psycasts available in the regular level 7-10 pool.
       Original ArchotechPsycast extension is deliberately removed. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Graftskip"]</xpath>
    <value><level>7</level></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Multicast"]</xpath>
    <value><level>8</level></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_ReverseGravity"]</xpath>
    <value><level>8</level></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_ReverseTime"]</xpath>
    <value><level>9</level></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Unmake"]</xpath>
    <value><level>10</level></value>
  </Operation>

  <Operation Class="PatchOperationRemove">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Graftskip" or defName="CoolPsycasts_Multicast" or defName="CoolPsycasts_ReverseGravity" or defName="CoolPsycasts_ReverseTime" or defName="CoolPsycasts_Unmake"]/modExtensions[li/@Class="CoolPsycasts.ArchotechPsycast"]</xpath>
  </Operation>
  <!-- Archotech activity is linked to separately acquired Archotech abilities.
       These five are now regular level-gated psycasts, so remove their former activity effect. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Graftskip" or defName="CoolPsycasts_Multicast" or defName="CoolPsycasts_ReverseGravity" or defName="CoolPsycasts_ReverseTime" or defName="CoolPsycasts_Unmake"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityCauseArchotechActivity"]</xpath>
  </Operation>

  <!-- Gamma Ray v6: 90 direct Burn injury, 3x v5; actual damage uses DamageDef.defaultDamage. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/DamageDef[defName="CoolPsycasts_GammaRadiation"]/defaultDamage</xpath>
    <value><defaultDamage>90</defaultDamage></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_GammaRay"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilitySpew"]/damAmount</xpath>
    <value><damAmount>90</damAmount></value>
  </Operation>

  <!-- Gravity Pulse v8: radius 14, three 30-damage armor-piercing hits, smooth pull, light flashes and stun. -->




  <!-- Learn: keep the rest of the ability/costs intact, switch only its effect class. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Learn"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityLearn"]</xpath>
    <value>
      <li Class="CoolerPsycastsTweaks.CompProperties_ChooseSkill">
        <baseAmount>10000</baseAmount>
      </li>
    </value>
  </Operation>

  <!-- Long cooldowns are handled and saved by RimWorld 1.6's Ability system.
       60000 ticks/day * 7 days = 420000 ticks. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Unmake"]</xpath>
    <value><cooldownTicksRange>420000</cooldownTicksRange></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_ReverseTime"]</xpath>
    <value><cooldownTicksRange>420000</cooldownTicksRange></value>
  </Operation>

  <!-- Unmake: 100% recipe/build cost reconstruction instead of standard disassembly. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Unmake"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityUnmake"]</xpath>
    <value><li Class="CoolerPsycastsTweaks.CompProperties_RecipeUnmake" /></value>
  </Operation>

  <!-- Reverse Time: full health reset + reconstruction of missing/added limbs.
       TimeSickness is a separate original comp and still applies after the reset. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_ReverseTime"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityReverseTime"]</xpath>
    <value><li Class="CoolerPsycastsTweaks.CompProperties_ResetBody" /></value>
  </Operation>

  <!-- Reverse Gravity: 6 cell AOE; use our own fall flyer to write injury
       Hediffs directly instead of regular blunt TakeDamage. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_ReverseGravity"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityMakeFallFlyer"]</xpath>
    <value>
      <li Class="CoolerPsycastsTweaks.CompProperties_DirectFall">
        <radius>6</radius>
        <flyerDef>CPT_DirectFallingFlyer</flyerDef>
      </li>
    </value>
  </Operation>

  <!-- Gravity Pulse cast targeting range 40 cells; separate effect radius is 14. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_GravityPulse"]/verbProperties/range</xpath>
    <value><range>40</range></value>
  </Operation>

  <!-- Normal damage pipeline with 300% armor penetration (3.0) -->



  <!-- Ease Gravity: 10% upfront, one day, 50% move speed, no ongoing drain -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EaseGravity"]/statBases/Ability_PsyfocusCost</xpath>
    <value><Ability_PsyfocusCost>0.1</Ability_PsyfocusCost></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EaseGravity"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityToggleHediff"]</xpath>
    <value>
      <li Class="CoolerPsycastsTweaks.CompProperties_TimedGravity">
        <hediffDef>CoolPsycasts_EaseGravityHD</hediffDef>
        <durationTicks>60000</durationTicks>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EaseGravityHD"]/comps/li[@Class="CoolPsycasts.HediffCompProperties_PsyfocusPerTick"]</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EaseGravityHD"]/comps</xpath>
    <value><li Class="HediffCompProperties_Disappears"><disappearsAfterTicks>60000</disappearsAfterTicks></li></value>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EaseGravityHD"]/stages/li/statOffsets</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EaseGravityHD"]/stages/li/statFactors</xpath>
    <value><MoveSpeed>1.5</MoveSpeed></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EaseGravity"]/description</xpath>
    <value><description>Reduces gravity for 24 game-hours. Doubles carrying capacity and grants 50% more movement speed at 10% psyfocus cost, without continuing drain.</description></value>
  </Operation>

  <!-- Controlled focus: 10000 ticks for 100%, up to 30 neural heat. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EntropicFocus"]/statBases/Ability_PsyfocusCost</xpath>
    <value><Ability_PsyfocusCost>0</Ability_PsyfocusCost></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EntropicFocusHD"]/comps</xpath>
    <value><comps><li Class="CoolerPsycastsTweaks.HediffCompProperties_ControlledFocus">
       <focusPerTick>0.0001</focusPerTick><heatPerTick>0.003</heatPerTick>
    </li></comps></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/HediffDef[defName="CoolPsycasts_EntropicFocusHD"]/stages/li/statFactors/PsychicEntropyRecoveryRate</xpath>
    <value><PsychicEntropyRecoveryRate>1</PsychicEntropyRecoveryRate></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EntropicFocus"]/description</xpath>
    <value><description>Charges psyfocus from empty to full in four game-hours, producing limited neural heat and keeping natural neural heat recovery. Ends when psyfocus is full.</description></value>
  </Operation>

  <!-- Embedded trap: 24 hours -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="CoolPsycasts_TrapPsycast"]/comps/li[@Class="CompProperties_DestroyAfterDelay"]/delayTicks</xpath>
    <value><delayTicks>60000</delayTicks></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Embed"]/description</xpath>
    <value><description>Embed a known psycast as a trap for up to 24 game-hours. A hostile psychic pawn triggers it on the trap cell.</description></value>
  </Operation>
  <!-- Remove obsolete original tooltip, which still calculates 0.5 neural heat/tick. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_EntropicFocus"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityPreviewPsyfocusAmount"]</xpath>
  </Operation>

  <!-- v5 Gamma Ray: original directional radiation cone, direct Burn hediff and cancer
       via the C# worker, bypassing armor and Combat Tweaks' apparel absorption. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/DamageDef[defName="CoolPsycasts_GammaRadiation"]/workerClass</xpath>
    <value><workerClass>CoolerPsycastsTweaks.DamageWorker_DirectGamma</workerClass></value>
  </Operation>

  <!-- v7: smooth suction (visual PawnTweener interpolation + real cell movement),
       three separate 30-damage Blunt/Crush pulses with 1000% AP and 180-tick stun. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_GravityPulse"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityExplosion"]</xpath>
    <value>
      <li Class="CoolerPsycastsTweaks.CompProperties_GravityConvergence">
        <radius>14</radius>
        <pullCells>14</pullCells>
        <damagePerPulse>30</damagePerPulse>
        <armorPenetration>10</armorPenetration>
        <stunTicks>180</stunTicks>
        <marker>CoolPsycasts_GravityPulseMarker</marker>
        <pullHediff>CPT_GravityPulled</pullHediff>
        <stepIntervalTicks>18</stepIntervalTicks>
        <holdTicks>120</holdTicks>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_GravityPulse"]/description</xpath>
    <value><description>Draws all pawns within 14 cells smoothly toward the target point. Three luminous armor-piercing crush pulses deal 30 damage each (1000% armor penetration): one during the pull, one during the brief hold, and one at release. Survivors are stunned for 3 seconds. Cast range: 40 cells. Walls and occupied cells block movement.</description></value>
  </Operation>
</Patch>
