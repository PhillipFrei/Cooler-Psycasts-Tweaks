<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Only Timeshunt's ability-effect comp changes. The original skyfaller
       is still used for non-pawn targets; pawn return is now game-global. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/AbilityDef[defName="CoolPsycasts_Timeshunt"]/comps/li[@Class="CoolPsycasts.CompProperties_AbilityMidairSkip"]</xpath>
    <value>
      <li Class="CoolerPsycastsTweaks.CompProperties_GlobalTimeshunt">
        <skyfaller>TimeshuntSkyfaller</skyfaller>
      </li>
    </value>
  </Operation>
</Patch>